    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "allowScripts": {
