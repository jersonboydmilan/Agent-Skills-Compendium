{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jersonboydmilan/Agent-Skills-Compendium/schema/skill.schema.json",
  "title": "Agent Skill",
  "description": "The canonical Agent Skill Specification. Generated from src/lib/schema.ts — edit that file, then run `npm run generate:schema`. Do not edit by hand.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "layer": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "domain": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "required",
          "type",
          "description"
        ]
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedure": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "step",
          "description"
        ]
      }
    },
    "decision_rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "condition",
          "action"
        ]
      }
    },
    "outputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type",
          "description"
        ]
      }
    },
    "validation": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check"
        ]
      }
    },
    "failure_modes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "failure",
          "mitigation"
        ]
      }
    },
    "escalation": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "condition",
          "action"
        ]
      }
    },
    "examples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "title",
          "input",
          "output"
        ]
      }
    },
    "related_skills": {
      "default": {
        "prerequisites": [],
        "complementary": [],
        "successors": [],
        "related": []
      },
      "type": "object",
      "properties": {
        "prerequisites": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        },
        "complementary": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        },
        "successors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        },
        "related": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        }
      }
    },
    "complexity": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "build_speed": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "shareability": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "experimental",
        "prototype",
        "beta",
        "production"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "default": "Agent Skills Compendium",
      "type": "string"
    },
    "license": {
      "default": "MIT",
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "required_permissions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restricted_actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "version",
    "category",
    "layer",
    "description",
    "purpose",
    "trigger",
    "inputs",
    "procedure",
    "outputs",
    "validation",
    "failure_modes",
    "complexity",
    "build_speed",
    "shareability",
    "maturity",
    "risk_level",
    "created_at",
    "updated_at"
  ]
}
